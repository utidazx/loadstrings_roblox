local K={85,116,105,100,97,72,117,98,88,45,84,97,112,83,105,109,117,108,97,116,111,114,82,101,98,111,114,110,45,50,48,50,54}
local bxor=(bit32 and bit32.bxor) or function(a,b)
    local r,p=0,1
    while a>0 or b>0 do
        local x,y=a%2,b%2
        if x~=y then r=r+p end
        a=(a-x)/2;b=(b-y)/2;p=p*2
    end
    return r
end
local B="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lut={}
for i=1,#B do lut[B:sub(i,i)]=i-1 end
local function b64dec(s)
    s=s:gsub("[^"..B.."=]","")
    local out,buf,bits={},0,0
    for i=1,#s do
        local ch=s:sub(i,i)
        if ch=="=" then break end
        buf=buf*64+lut[ch]
        bits=bits+6
        if bits>=8 then
            bits=bits-8
            local byte=math.floor(buf/(2^bits))%256
            out[#out+1]=byte
            buf=buf%(2^bits)
        end
    end
    return out
end
local bytes=b64dec(D)
local nk=#K
local chars={}
for i=1,#bytes do
    local dec=bxor(bxor(bytes[i],K[((i-1)%nk)+1]),(i-1)%256)
    chars[i]=string.char(dec)
end
local parts,src={},nil
local step=4096
for i=1,#chars,step do
    parts[#parts+1]=table.concat(chars,"",i,math.min(i+step-1,#chars))
end
src=table.concat(parts)
local fn,err=loadstring(src)
if not fn then return warn("[Tap Simulator Reborn] loader failed: "..tostring(err)) end
return fn()
